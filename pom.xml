<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>club.dwdc</groupId>
    <artifactId>club.dwdc.keymaster.e2etest</artifactId>
    <version>0.3.0</version>

    <name>keymaster-e2e-test</name>
    <description>End-to-end tests for KeyMaster — uses Testcontainers to run relay and avatar, embedded km-daemon.</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <keymaster.version>0.5.0</keymaster.version>
        <keyvault.version>0.2.0</keyvault.version>
        <junit.version>5.13.1</junit.version>
        <surefire.version>3.5.2</surefire.version>
        <testcontainers.version>1.20.6</testcontainers.version>
        <slf4j.version>2.0.9</slf4j.version>
        <logback.version>1.4.14</logback.version>
    </properties>

    <repositories>
        <repository>
            <id>reposilite-releases</id>
            <url>https://maven.398ja.xyz/releases</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>club.dwdc</groupId>
            <artifactId>club.dwdc.keymaster.core</artifactId>
            <version>${keymaster.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>club.dwdc</groupId>
            <artifactId>club.dwdc.keymaster.daemon</artifactId>
            <version>${keymaster.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>club.dwdc</groupId>
            <artifactId>club.dwdc.keymaster.desktop</artifactId>
            <version>${keymaster.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>club.dwdc</groupId>
            <artifactId>club.dwdc.keyvault.core</artifactId>
            <version>${keyvault.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>club.dwdc</groupId>
            <artifactId>club.dwdc.keyvault.desktop</artifactId>
            <version>${keyvault.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <excludes>
                        <exclude>**/KeyMasterSystemTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>system-test</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${surefire.version}</version>
                        <configuration>
                            <excludes>
                                <exclude>none</exclude>
                            </excludes>
                            <includes>
                                <include>**/KeyMasterSystemTest.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
